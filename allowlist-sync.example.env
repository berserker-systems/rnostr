# /etc/rnostr/allowlist-sync.env; systemd syntax, without export.
# CLI options replace corresponding environment values.
ALLOWLIST_AUTHORITY=npub1replace_me_with_the_registry_operator
# Dedicated recipient nsec, mode 0600, owned by the service user.
ALLOWLIST_RECIPIENT_NSEC_FILE=/etc/rnostr/allowlist-sync.nsec
ALLOWLIST_RELAYS=wss://relay.example.com
# ALLOWLIST_PUBLIC_RELAYS=wss://public.example.com
ALLOWLIST_POLICY_FILE=/var/lib/allowlist-sync/allowlist.json

# ALLOWLIST_EXTRA_PUBKEYS=npub1admin...,npub1backup...
# ALLOWLIST_EVENT_KIND=30617
# ALLOWLIST_RESYNC_INTERVAL=60s
RUST_LOG=info

# ExecStart option: --fetch-timeout (default 10s).
