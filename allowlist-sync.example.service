# Example systemd unit for allowlist-sync, the sidecar that keeps an rnostr
# [auth] allowlist in sync with a NIP-34 repo announcement.
#
# Install to /etc/systemd/system/allowlist-sync.service and pair it with
# allowlist-sync.example.env, copied to the EnvironmentFile path below.
#
# The relay itself must run with `--watch` for these edits to apply without a
# restart, and the config named by ALLOWLIST_CONFIG must be owned by User=
# below.

[Unit]
Description=Sync rnostr auth allowlist from a NIP-34 repo announcement
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rnostr
Group=rnostr
EnvironmentFile=/etc/rnostr/allowlist-sync.env
ExecStart=/usr/local/bin/allowlist-sync
Restart=on-failure
RestartSec=30s

# The sidecar needs to write the config directory and nothing else.
ProtectSystem=strict
ReadWritePaths=/etc/rnostr
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

# For a periodic one-shot instead of a long-lived subscription, set
# Type=oneshot, add `--once` to ExecStart, drop Restart=, and drive it from a
# timer. `--once` exits non-zero when no announcement is found or the fetch
# fails, so a failed run is visible in `systemctl status`.
