# Example environment file for allowlist-sync.
#
# Copy to a location readable by the service user and reference it from the
# unit with `EnvironmentFile=/etc/rnostr/allowlist-sync.env`.
#
# Note on syntax: systemd reads this file itself, not through a shell. Do not
# use `export`, and keep comments on their own lines -- a `#` after a value is
# part of the value.
#
# Note on precedence: every ALLOWLIST_* variable below has an equivalent
# command line flag, and passing the flag *replaces* the variable rather than
# adding to it. This matters most for the comma separated lists: an
# `--extra-pubkey` on ExecStart discards every key in ALLOWLIST_EXTRA_PUBKEYS
# instead of appending to them. Set each value in one place or the other, never
# both. The startup log reports the authority, identifier and extra-key count
# actually in use -- check it after any change here.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The repo owner whose kind-30617 announcement is trusted. Only events signed
# by this key are ever applied. npub or 64-char hex.
#
# Changing this later also means deleting the state file named under
# ALLOWLIST_CONFIG below: it records the authority it was written for, and the
# sidecar refuses to start against a mismatched one rather than inherit another
# authority's rollback floor. The error names the file to remove.
ALLOWLIST_AUTHORITY=npub1replace_me_with_the_repo_owner

# The `d` tag identifier of the NIP-34 repo announcement to follow. Changing
# this requires deleting the state file, same as ALLOWLIST_AUTHORITY.
ALLOWLIST_IDENTIFIER=my-repo

# Relays to read the announcement from, comma separated. Prefer relays other
# than the one being configured: if this relay is the only source and its
# allowlist locks the sidecar out, it can no longer see updates.
ALLOWLIST_RELAYS=wss://relay.example.com,wss://other.example.com

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Operator keys that are always allowed, on top of the announced set, comma
# separated. Use this for break-glass/admin keys that are not maintainers of
# the announced repo. These are applied on every write but never recorded in
# the state file, so edits here take effect on the next write -- and removing
# one drops it again.
#
# They are not a bootstrap mechanism: nothing is written until an announcement
# has been applied at least once. After that first success the state file lets
# edits here land even while every relay is unreachable, but on a fresh install
# with no connectivity the config is left untouched.
# ALLOWLIST_EXTRA_PUBKEYS=npub1admin...,npub1backup...

# The rnostr config to keep in sync. The service user must own this file and
# be able to write its directory: updates are written to a temporary file in
# the same directory and renamed into place, preserving the original's owner,
# mode and extended attributes. A config owned by root while the sidecar runs
# unprivileged fails every apply with `cannot preserve config ownership`, even
# if the directory is writable -- `chown` it to the service user.
#
# The sync state is stored beside it as <config-name>.allowlist-sync-state,
# so the directory needs room for that file too.
#
# Default: ./config/rnostr.toml, relative to the working directory. Prefer an
# absolute path under systemd.
ALLOWLIST_CONFIG=/etc/rnostr/rnostr.toml

# How often to refetch the announcement in full. This is also the retry
# interval after a transient failure and the window in which manual edits to
# the managed whitelists are reverted. Plain seconds or `<n>s`.
#
# Default: 60s
# ALLOWLIST_RESYNC_INTERVAL=60s

# Log level for the sidecar (info, debug, warn, error).
#
# Default: info
RUST_LOG=info

# ---------------------------------------------------------------------------
# Flags without an environment variable
# ---------------------------------------------------------------------------
#
# Put these on ExecStart:
#
#   --once             fetch, apply, and exit; exits non-zero when no
#                      announcement is found or the fetch fails. Use with
#                      Type=oneshot and a timer instead of a long-lived
#                      subscription.
#   --fetch-timeout    per-fetch timeout (default 10s)
#
# Reminder: rnostr itself must run with `--watch` for these edits to be picked
# up without a restart.
